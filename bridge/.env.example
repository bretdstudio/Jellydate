# Jellyfin should normally be reachable only on your LAN or over HTTPS.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# Bridge HTTP binds to loopback by default. Set BRIDGE_HOST=0.0.0.0 for a
# physical Playdate on your LAN, and keep your firewall in mind.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7789
STREAM_PORT=7790

# Required for every /api request and TCP stream connection.
JELLYDATE_TOKEN=replace-with-a-long-random-token

# Native-resolution hardware profile. Delta frames keep 400x240 video within
# the Playdate's measured Wi-Fi budget. Set VIDEO_DELTA_FRAMES=false when
# debugging the uncompressed wire path in Simulator.
VIDEO_FPS=5
VIDEO_WIDTH=400
VIDEO_HEIGHT=240
VIDEO_DELTA_FRAMES=true
VIDEO_DELTA_REPEAT_RUNS=true
VIDEO_KEYFRAME_INTERVAL_SECONDS=30
# Zero locks the tested profile at 5 FPS. Set a positive value to enable the
# adaptive video-only safety governor on unusually weak Wi-Fi.
VIDEO_WIRE_BUDGET_KIB_PER_SECOND=0
VIDEO_DITHER_HYSTERESIS=16
AUDIO_SAMPLE_RATE=8000
AUDIO_SAMPLE_FORMAT=s8
PROGRESS_REPORT_INTERVAL_MS=10000
FFMPEG_PATH=ffmpeg

# Optional: set this and use item id "__test__" to prove video without Jellyfin.
# TEST_MEDIA_PATH=/absolute/path/to/a/movie.mp4
