{
  "name": "@jellydate/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "generate-playdate-config": "node scripts/generate-playdate-config.mjs",
    "benchmark-delta": "tsx src/tools/benchmark-delta.ts",
    "soak": "tsx src/tools/soak.ts",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@jellyfin/sdk": "^0.13.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
